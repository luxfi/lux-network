+  // Graceful degradation when Square is not provisioned.
+  //
+  // react-square-web-payments-sdk's <PaymentForm> mounts an internal ErrorScreen
+  // that *throws* in production (NODE_ENV !== 'development') when applicationId or
+  // locationId are empty. The NEXT_PUBLIC_SQUARE_* values are inlined at build
+  // time; a deployment without Square merchant credentials resolves them to '',
+  // so mounting <PaymentForm> unwinds React to the global error boundary and the
+  // whole route white-screens with "Application error: a client-side exception
+  // has occurred". Guarding here keeps the rest of checkout (cart / order
+  // summary) intact and renders a clear "coming soon" state in place of the card
+  // form instead of initializing Square with empty credentials. Placed after all
+  // hooks so the Rules of Hooks hold.
+  const squareConfigured = Boolean(process.env.NEXT_PUBLIC_SQUARE_APPLICATION_ID)
+    && Boolean(process.env.NEXT_PUBLIC_SQUARE_LOCATION_ID)
+  if (!squareConfigured) {
+    return (
+      <ApplyTypography className='flex flex-col mt-6 gap-2 text-center'>
+        <h6 className='mx-auto'>Card payments coming soon</h6>
+        <p className='mx-auto text-muted'>
+          Online card checkout isn’t available yet. Your cart is saved — please
+          check back soon.
+        </p>
+      </ApplyTypography>
+    )
+  }
