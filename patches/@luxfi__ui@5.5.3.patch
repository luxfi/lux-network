+const LuxLogo: React.FC<LucideProps> = ({ className, style }: LucideProps) => (
+  <CanonicalLuxLogo
+    variant='white'
+    size='100%'
+    className={className as string | undefined}
+    style={style as React.CSSProperties | undefined}
+  />
 )
 
