+import { LuxLogo as CanonicalLuxLogo } from '@luxfi/logo/react'
+
+/*
+  Canonical Lux brand mark.
+
+  Sourced from the official @luxfi/logo package (github.com/luxfi/logo) rather
+  than an inline copy, so every surface that renders a Lux logo inherits the one
+  canonical mark. The component lives at @luxfi/logo/react (the package root
+  exports only data/helpers). It fills its wrapper (size='100%'), so the Tailwind
+  h-/w- sizing classes passed in via className continue to drive the rendered
+  dimensions exactly as before.
